# Facilitator PIN for every workshop's /present view. Locally it defaults to 0000.
FACILITATOR_PIN=
# Any long random string; signs the facilitator cookie.
SESSION_SECRET=

# Supabase: server-side storage for slide position, answers and the timeline.
# Without these the app uses an in-memory store (fine locally, not on Netlify).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Realtime for instant sync. Without these the app polls every 1.5s.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
