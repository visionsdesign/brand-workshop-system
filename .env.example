# Facilitator PIN for every workshop's /present view. Locally it defaults to 0000.
FACILITATOR_PIN=
# Any long random string; signs the facilitator cookie.
SESSION_SECRET=

# Supabase: server-side storage for slide position, answers and the timeline.
# Without these the app uses an in-memory store (fine locally, not on Netlify).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Realtime for instant sync. Without these the app polls every 1.5s.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Team area: only emails on this domain can sign in (default visionsdesign.co.uk)
TEAM_EMAIL_DOMAIN=visionsdesign.co.uk

# Claude API key for the AI-guided self-serve mode
ANTHROPIC_API_KEY=

# Stripe checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRICE_GUIDED_PENCE=
PRICE_SELF_SERVE_PENCE=
PRICES_INCLUDE_VAT=false
# Cal.com booking for guided sessions
CALCOM_LINK=
CALCOM_WEBHOOK_SECRET=

# Google Drive (read-only service account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Drive sync: a folder in a Shared Drive where the service account is a Content manager (link or ID)
GOOGLE_DRIVE_SYNC_FOLDER=

# ElevenLabs voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
